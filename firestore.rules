rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Public website content ----
    // Anyone can READ (the live site renders from these); only a signed-in
    // admin can WRITE.
    match /settings/{doc}          { allow read: if true; allow write: if request.auth != null; }
    match /services/{doc}          { allow read: if true; allow write: if request.auth != null; }
    match /blogPosts/{doc}         { allow read: if true; allow write: if request.auth != null; }
    match /testimonials/{doc}      { allow read: if true; allow write: if request.auth != null; }
    match /videoTestimonials/{doc} { allow read: if true; allow write: if request.auth != null; }

    // ---- Admin-only image library (base64 fallback when Storage is off) ----
    match /imageLibrary/{doc}      { allow read, write: if request.auth != null; }

    // ---- Private clinical data (PHI) — signed-in admin ONLY, never public ----
    match /patients/{doc}          { allow read, write: if request.auth != null; }
    match /clinicalNotes/{doc}     { allow read, write: if request.auth != null; }

    // Default deny everything else.
    match /{document=**}           { allow read, write: if false; }
  }
}
